# ============================================================
# 校园二手交易平台 - 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值；.env 已被 gitignore 忽略
# 未设置环境变量时，application.yml 会使用冒号后的本地默认值
# ============================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_trade
DB_USERNAME=root
DB_PASSWORD=123456

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 邮件（QQ 邮箱授权码，非登录密码）----------
# 在 QQ 邮箱 设置-账户 开启 SMTP 后获取
MAIL_USERNAME=your_qq@qq.com
MAIL_PASSWORD=your_smtp_authorization_code

# ---------- JWT ----------
# 生产环境务必更换为随机长字符串
JWT_SECRET=campusTradeSecretKeyMustBeAtLeast32CharsLong!

# ---------- DeepSeek（AI 文案润色，可选）----------
# 未配置时润色接口返回演示文案
DEEPSEEK_API_KEY=

# ---------- Python AI 服务（阶段 C 起）----------
# Java 通过该地址调用 Python ai-service；默认本机 8001 端口
AI_SERVICE_BASE_URL=http://127.0.0.1:8001

# ---------- 阿里云 OSS（可选，不配置则用本地存储）----------
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_DOMAIN=

# ============================================================
# 以下为后续阶段预留，当前阶段暂不使用
# ============================================================
# ---------- Embedding 服务（阶段 D：RAG）----------
# 智谱 / 通义千问 等，提供 embedding API
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
